---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const experience = [
	{
		role: "Machine Learning Engineer (Working Student)",
		company: "U-Glow",
		location: "Remote, Germany",
		date: "Apr 2026–Present",
		prevRole: "ML Intern, Apr–Jul 2026",
		bullets: [
			"Built a financial analytics application featuring real-time KPI tables and time-series visualizations.",
			"Fine-tuned FinBERT and RoBERTa sentiment models to generate actionable trading signals.",
			"Constructed automated data pipelines from financial APIs, SEC filings, and social text.",
			"Led quality assurance and model validation for the initial product launch."
		]
	},
	{
		role: "AI Research Intern",
		company: "Koç University (@GGLab)",
		location: "Remote, Türkiye",
		date: "Apr 2025–Apr 2026",
		bullets: [
			"Defined BNF grammar rules and analyzed morphological and syntactic structures for low-resource languages.",
			"Developed structured linguistic datasets to evaluate LLM reasoning capabilities on Linguistic Olympiad-style problems."
		]
	},
	{
		role: "Software Developer",
		company: "Mars Athletic Club",
		location: "Istanbul, Türkiye",
		date: "Sep 2024–Oct 2025",
		prevRole: "Technology Intern May–Sep 2024",
		bullets: [
			"Drove product development using Angular, TypeScript, NgRx, and RxJS within an agile team.",
			"Designed and built a RAG-driven internal chatbot, a Copilot Studio Teams bot, and a custom GPT tool to optimize workflows across internal departments."
		]
	}
];
---

<Layout title="Kaya Meriç Engin | Machine Learning Engineer">
	<Nav slot="nav" />
	
	<section class="hero slide-up">
		<h1 class="name">Kaya Meriç Engin</h1>
		<p class="title">ML Engineer &middot; MSc Computational Linguistics, University of Stuttgart</p>
		<p class="positioning">I build NLP and AI systems end to end — from model and evaluation design to the product they ship in.</p>
	</section>

	<section class="about slide-up delay-1">
		<h2 class="section-title">01. About</h2>
		<div class="content-block">
			<p>Machine Learning Engineer and M.Sc. Computational Linguistics student, with a B.A. in German Language and Literature. My background is in language before it was in machine learning, which shapes how I approach both.</p>
			
			<p>I build AI, ML, and NLP systems — day to day that's Python and TypeScript, RAG pipelines and vector databases, and full-stack development, alongside NLP research.</p>

			<p>Currently ML Engineer @ U-Glow.</p>

			<p>Outside of work, I write stories and build games.</p>
		</div>
	</section>

	<hr class="section-divider" />

	<section class="experience slide-up delay-2">
		<h2 class="section-title">02. Experience</h2>
		<div class="timeline">
			{experience.map((job) => (
				<div class="job">
					<div class="job-header">
						<h3 class="role">{job.role} <span class="company">at {job.company}</span></h3>
						<span class="meta">{job.date} &middot; {job.location}</span>
					</div>
					{job.prevRole && <p class="prev-role text-muted">Previously: {job.prevRole}</p>}
					<ul class="bullets">
						{job.bullets.map((bullet) => (
							<li>{bullet}</li>
						))}
					</ul>
				</div>
			))}
			
			<div class="job condensed">
				<p class="text-muted"><strong>Earlier Chapter:</strong> German & English Language Teacher (Just English Language & TOEFL Center, 2021–2022) and Sales & Team Lead (Guess Inc., 2022–2023). A foundation in structured communication, teaching, and process management.</p>
			</div>
		</div>
	</section>

	<hr class="section-divider" />

	<section class="selected-work slide-up delay-3">
		<h2 class="section-title">03. Selected Work & Research</h2>
		<div class="work-teaser">
			<ul class="teaser-list">
				<li><strong>Financial Sentiment Pipeline:</strong> Contributed to fine-tuning transformers (FinBERT/RoBERTa) and building automated data pipelines for trading signals.</li>
				<li><strong>Enterprise AI Tooling:</strong> Worked on the development of RAG-driven internal chatbots and Copilot Studio bots for departmental workflows.</li>
				<li><strong>Architecture & Engineering:</strong> Collaborated with a cross-functional team on scalable Angular/NgRx systems (candidate tracking, membership portals, and onboarding flows) at Mars Athletic Club.</li>
			</ul>
			<div class="teaser-links">
				<a href={`${import.meta.env.BASE_URL}work`} class="action-link">View all projects &rarr;</a>
				<a href={`${import.meta.env.BASE_URL}research`} class="action-link">View all research &rarr;</a>
			</div>
		</div>
	</section>

	<hr class="section-divider" />
	
	<div class="two-col-layout slide-up delay-4">
		<section class="skills">
			<h2 class="section-title">04. Skills</h2>
			<div class="skill-groups">
				<div class="skill-group">
					<span class="skill-label">ML & NLP</span>
					<p>PyTorch, Scikit-learn, SpaCy, NLTK, Transformer Fine-tuning, LLM Evaluation Design, Machine Learning, Deep Learning</p>
				</div>
				<div class="skill-group">
					<span class="skill-label">Engineering</span>
					<p>Python, FastAPI, NumPy, Pandas, Matplotlib, Seaborn, Hugging Face Transformers, HTML, CSS, JavaScript, TypeScript, React, Angular, Node.js, Docker, LaTeX, Git</p>
				</div>
				<div class="skill-group">
					<span class="skill-label">Languages</span>
					<p>German (C1), English (C1), Turkish (C2)</p>
				</div>
			</div>
		</section>

		<section class="education">
			<h2 class="section-title">05. Education</h2>
			<div class="edu-item">
				<h3 class="degree">MSc Computational Linguistics</h3>
				<p class="school">University of Stuttgart &middot; 2025–2027</p>
				<p class="text-muted">TEV-DAAD Scholarship</p>
			</div>
			<div class="edu-item">
				<h3 class="degree">BA German Language & Literature</h3>
				<p class="school">Istanbul University &middot; 2019–2024</p>
				<p class="text-muted">GPA 3.6, Magna Cum Laude</p>
			</div>
			
			<div class="certifications mt-2">
				<h3 class="sub-title">Certifications</h3>
				<p class="text-muted text-sm">IELTS 8.0 &middot; DeepLearning.AI - Andrew Ng's ML & NLP Specializations &middot; Meta Front-End Developer &middot; Python for Everybody</p>
			</div>
		</section>
	</div>

	<hr class="section-divider" id="contact" />

	<section class="contact slide-up delay-5">
		<h2 class="section-title">06. Contact</h2>
		<p>Currently based in Stuttgart, Germany. Open to discussing NLP/LLM research, AI product engineering, and game dev.</p>
		<div class="contact-actions">
			<a href="mailto:kayamericengin@gmail.com" class="action-link">kayamericengin@gmail.com</a>
		</div>
	</section>

	<Footer slot="footer" />
</Layout>

<style>
	/* Animation */
	.slide-up {
		opacity: 0;
		transform: translateY(15px);
		animation: slideUpFade 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}
	.delay-1 { animation-delay: 0.1s; }
	.delay-2 { animation-delay: 0.2s; }
	.delay-3 { animation-delay: 0.3s; }
	.delay-4 { animation-delay: 0.4s; }
	.delay-5 { animation-delay: 0.5s; }
	
	@keyframes slideUpFade {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.section-title {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--c-ink-light);
		margin-bottom: 2rem;
		font-weight: 500;
	}

	/* Hero */
	.hero {
		margin-top: 2rem;
		margin-bottom: 4rem;
	}
	.name {
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
		font-weight: 400;
		letter-spacing: -0.02em;
	}
	.title {
		font-size: 1.1rem;
		color: var(--c-ink-light);
		margin-bottom: 1.5rem;
		font-family: var(--font-sans);
	}
	.positioning {
		font-size: 1.25rem;
		line-height: 1.5;
		max-width: 600px;
		color: var(--c-ink);
		font-family: var(--font-serif);
	}
	
	@media (min-width: 768px) {
		.name { font-size: 3rem; }
		.positioning { font-size: 1.4rem; }
	}

	/* Content Blocks */
	.content-block {
		max-width: 640px;
		font-size: 1.05rem;
	}

	/* Experience */
	.job {
		margin-bottom: 2.5rem;
	}
	.job:last-child {
		margin-bottom: 0;
	}
	.job-header {
		display: flex;
		flex-direction: column;
		margin-bottom: 0.25rem;
		gap: 0.15rem;
	}
	.role {
		font-family: var(--font-sans);
		font-size: 1.1rem;
		font-weight: 600;
		margin: 0;
	}
	.company {
		font-weight: 400;
		color: var(--c-ink-light);
	}
	.meta {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--c-ink-light);
		margin-top: 0.25rem;
	}
	.prev-role {
		font-size: 0.9rem;
		margin-bottom: 1rem;
		font-style: italic;
	}
	.bullets {
		margin-top: 1rem;
		margin-bottom: 0;
		max-width: 640px;
	}
	.job.condensed {
		border-left: 2px solid var(--c-border);
		padding-left: 1rem;
		margin-top: 3rem;
	}
	.job.condensed p {
		margin: 0;
		font-size: 0.95rem;
	}

	/* Selected Work */
	.teaser-list {
		list-style: none;
		padding: 0;
		margin: 0 0 1.5rem 0;
	}
	.teaser-list li {
		margin-bottom: 0.75rem;
		font-size: 1.05rem;
	}
	.teaser-list li strong {
		font-weight: 500;
	}
	.teaser-links {
		display: flex;
		gap: 1.5rem;
		margin-top: 1.5rem;
	}

	/* Two Col Layout */
	.two-col-layout {
		display: grid;
		grid-template-columns: 1fr;
		gap: 4rem;
	}
	@media (min-width: 768px) {
		.two-col-layout {
			grid-template-columns: 1fr 1fr;
			gap: 3rem;
		}
	}

	/* Skills */
	.skill-groups {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.skill-group p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
	}
	.skill-label {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--c-ink-light);
		margin-bottom: 0.25rem;
		text-transform: uppercase;
	}

	/* Education */
	.edu-item {
		margin-bottom: 1.5rem;
	}
	.degree {
		font-family: var(--font-sans);
		font-size: 1.05rem;
		font-weight: 600;
		margin-bottom: 0.25rem;
	}
	.school {
		margin-bottom: 0.25rem;
	}
	.sub-title {
		font-family: var(--font-sans);
		font-size: 0.95rem;
		font-weight: 600;
		margin-bottom: 0.25rem;
	}
	.mt-2 {
		margin-top: 2rem;
	}
	.text-sm {
		font-size: 0.85rem;
	}

	/* Contact */
	.contact-actions {
		margin-top: 1.5rem;
	}
	.action-link {
		font-family: var(--font-mono);
		font-size: 1.1rem;
		text-decoration: none;
		border-bottom: 1px solid var(--c-ink);
		padding-bottom: 2px;
	}
	.action-link:hover {
		color: var(--c-accent);
		border-color: var(--c-accent);
	}
</style>
