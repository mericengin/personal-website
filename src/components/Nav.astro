---
const currentPath = Astro.url.pathname;

const links = [
	{ name: 'Home', path: '/' },
	{ name: 'Work', path: '/work' },
	{ name: 'Research', path: '/research' },
	{ name: 'Contact', path: '/#contact' }
];
---

<header class="site-header">
	<nav aria-label="Primary Navigation">
		<ul class="nav-list">
			{links.map((link) => {
				// Determine if link is active
				// Handle trailing slashes in currentPath for exact match on '/'
				const isActive = link.path === '/' 
					? currentPath === '/' || currentPath === '' 
					: currentPath.startsWith(link.path);
					
				return (
					<li>
						<a 
							href={link.path} 
							class:list={['nav-link', { active: isActive }]}
							aria-current={isActive ? "page" : undefined}
						>
							{link.name}
						</a>
					</li>
				);
			})}
		</ul>
	</nav>
</header>

<style>
	.site-header {
		margin-bottom: 2rem;
		font-family: var(--font-sans);
		font-size: 0.95rem;
	}

	.nav-list {
		display: flex;
		gap: 2rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.nav-link {
		text-decoration: none;
		color: var(--c-ink-light);
		transition: color 0.2s ease;
	}

	.nav-link:hover {
		color: var(--c-ink);
	}

	.nav-link.active {
		color: var(--c-ink);
		font-weight: 500;
	}
	
	/* Adding a subtle bottom border to the active nav item */
	.nav-link.active::after {
		content: '';
		display: block;
		width: 100%;
		height: 1px;
		background: var(--c-accent);
		margin-top: 2px;
	}
</style>
